# FixPoint Service - contoh konfigurasi PRODUCTION untuk InfinityFree
#
# Salin isi file ini menjadi .env di folder proyek pada hosting (htdocs/.env).
# JANGAN pernah meng-commit file .env yang sudah berisi nilai asli.
# Nilai bertanda <...> wajib diganti dengan data dari panel InfinityFree
# (MySQL Databases dan Accounts). Jangan menyalin nilai contoh apa adanya.

APP_NAME="FixPoint Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<subdomain-anda>.great-site.net

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database MySQL dari panel InfinityFree (menu MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=<sqlXXX.infinityfree.com>
DB_PORT=3306
DB_DATABASE=<if0_xxxxxxxx_fixpoint>
DB_USERNAME=<if0_xxxxxxxx>
DB_PASSWORD=<password-database>

# Session, cache, dan queue memakai driver file/sync karena hosting tidak
# menyediakan cron job maupun proses latar belakang. Tabel sessions tidak
# dibuat oleh migration proyek ini, jadi driver database tidak dapat dipakai.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fixpoint.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
