      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "schedule_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "service",
      "value": "laptop",
      "type": "string"
    }
  ],
