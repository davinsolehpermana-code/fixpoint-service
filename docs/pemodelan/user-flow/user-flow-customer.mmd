%% User Flow — Customer: perjalanan antarhalaman, bukan alur logika sistem
%% Halaman aktual: beranda, ketersediaan jadwal, booking, cek status

flowchart LR
    subgraph Masuk["Titik Masuk"]
        A1[Beranda FixPoint Service]
        A2[Navigasi: Ketersediaan Jadwal]
        A3[Navigasi: Cek Status]
    end

    subgraph Booking["Melakukan Booking"]
        B1[Halaman Booking]
        B2[Pilih kartu layanan<br/>+ lihat estimasi harga]
        B3[Pilih jadwal dari dropdown<br/>tanggal dan jam]
        B4[Pilih CASH atau QRIS]
        B5[Isi data diri, perangkat,<br/>dan keluhan]
        B6[Klik Kirim Booking]
    end

    subgraph Hasil["Mendapat Service ID"]
        C1[Notifikasi sukses +<br/>Service ID ditampilkan]
        C2[Catat / salin Service ID]
    end

    subgraph Status["Memantau Servis"]
        D1[Halaman Cek Status]
        D2[Input Service ID]
        D3[Kartu status servis:<br/>perangkat, jadwal, diagnosis,<br/>biaya, status pengerjaan]
        D4[Kartu pembayaran:<br/>metode, tagihan, status]
    end

    subgraph Tindakan["Tindakan Lanjutan"]
        E1[Unggah bukti QRIS]
        E2[Batalkan booking<br/>+ alasan]
        E3[Lihat bukti yang<br/>sudah diunggah]
        E4[Servis selesai<br/>dan lunas]
    end

    A1 --> B1
    A1 --> A2
    A2 --> B1
    A3 --> D1

    B1 --> B2 --> B3 --> B4 --> B5 --> B6 --> C1 --> C2 --> D1

    D1 --> D2 --> D3 --> D4

    D4 --> E1
    D4 --> E2
    D4 --> E3
    D4 --> E4

    E1 --> D3
    E2 --> D3
    E3 --> D3

    style A1 fill:#eff6ff,stroke:#2563eb
    style C1 fill:#f0fdf4,stroke:#16a34a
    style E4 fill:#f0fdf4,stroke:#16a34a
