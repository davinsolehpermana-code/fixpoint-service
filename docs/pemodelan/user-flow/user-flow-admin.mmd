%% User Flow — Admin: perjalanan antarhalaman dashboard
%% Halaman aktual: login, dashboard-admin, jadwal-servis, edit-jadwal-servis,
%% kelola-proses-servis, pembayaran, struk, data-service, riwayat-servis

flowchart LR
    subgraph Auth["Masuk"]
        A1[Halaman Login]
        A2[Pilih role Admin<br/>+ email dan password]
        A3[Dashboard Admin]
    end

    subgraph Jadwal["Menu Jadwal Servis"]
        J1[Daftar dan form jadwal baru]
        J2[Klik Edit pada baris jadwal]
        J3[Form edit:<br/>tanggal, jam, slot, status]
        J4[Simpan Perubahan]
        J5[Kembali ke daftar<br/>+ notifikasi hasil]
    end

    subgraph Servis["Menu Kelola Proses Servis"]
        S1[Daftar booking + filter status]
        S2[Pilih booking]
        S3[Panel detail: keluhan,<br/>perangkat, jadwal]
        S4[Terima booking]
        S5[Isi diagnosis, estimasi,<br/>biaya akhir, catatan]
        S6[Simpan proses servis]
    end

    subgraph Bayar["Menu Pembayaran"]
        P1[Daftar tagihan + filter<br/>Semua / Belum Bayar / Lunas]
        P2[Lihat bukti QRIS]
        P3[Konfirmasi CASH<br/>dengan uang diterima]
        P4[Konfirmasi QRIS]
        P5[Status lunas + cetak struk]
    end

    subgraph Laporan["Menu Riwayat Servis"]
        R1[Filter rentang tanggal<br/>+ pencarian]
        R2[Lihat ringkasan]
        R3[Unduh PDF / Excel]
    end

    A1 --> A2 --> A3
    A3 --> J1
    J1 --> J2 --> J3 --> J4 --> J5
    J5 --> J1

    A3 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6

    A3 --> P1 --> P2
    P1 --> P3 --> P5
    P1 --> P4 --> P5

    A3 --> R1 --> R2 --> R3

    style A3 fill:#eff6ff,stroke:#2563eb
    style P5 fill:#f0fdf4,stroke:#16a34a
    style J4 fill:#f0fdf4,stroke:#16a34a
    style S6 fill:#f0fdf4,stroke:#16a34a
