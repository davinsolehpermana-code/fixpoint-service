@startuml use-case-fixpoint
title Use Case Diagram — FixPoint Service
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  ArrowColor #475569
}

actor "Customer\n(tanpa akun)" as C
actor "Admin" as A
actor "Pemilik Usaha" as P

rectangle "FixPoint Service\nSistem Informasi Booking & Manajemen Jasa Servis Laptop dan PC" {

  ' ---------- Customer ----------
  usecase "Melihat layanan &\nestimasi harga" as UC01
  usecase "Melihat ketersediaan\njadwal" as UC02
  usecase "Melakukan booking servis" as UC03
  usecase "Menerima Service ID" as UC04
  usecase "Mengecek status servis" as UC05
  usecase "Melihat diagnosis,\nestimasi & total biaya" as UC06
  usecase "Membatalkan booking\n(status PENDING /\nWAITING_VERIFICATION)" as UC07
  usecase "Mengunggah bukti\npembayaran QRIS" as UC08
  usecase "Melihat bukti pembayaran\nmilik Service ID sendiri" as UC09

  ' ---------- Autentikasi internal ----------
  usecase "Login" as UC10
  usecase "Logout" as UC11

  ' ---------- Admin ----------
  usecase "Melihat dashboard\noperasional" as UC12
  usecase "Menambah jadwal servis" as UC13
  usecase "Mengedit tanggal, jam,\nkapasitas slot & status" as UC14
  usecase "Menutup / membuka jadwal" as UC15
  usecase "Menghapus jadwal\ntanpa booking" as UC16
  usecase "Mengelola layanan\n(tambah, ubah, aktif/nonaktif)" as UC17
  usecase "Melihat data customer\n& perangkat" as UC18
  usecase "Memverifikasi booking" as UC19
  usecase "Mencatat diagnosis, estimasi,\nbiaya akhir & status servis" as UC20
  usecase "Membatalkan booking\ndengan alasan" as UC21
  usecase "Memverifikasi pembayaran\nCASH / QRIS" as UC22
  usecase "Meminta upload ulang\nbukti QRIS" as UC23
  usecase "Mencetak struk pembayaran" as UC24
  usecase "Melihat riwayat servis,\nfilter tanggal & ekspor PDF/Excel" as UC25

  ' ---------- Pemilik Usaha ----------
  usecase "Melihat dashboard\npemantauan usaha" as UC26
  usecase "Memantau booking, diagnosis,\nbiaya & status pengerjaan" as UC27
  usecase "Melihat bukti pembayaran\nQRIS (read-only)" as UC28
  usecase "Melihat riwayat servis\n& ekspor PDF/Excel" as UC29
  usecase "Melihat laporan pemasukan\n& ekspor PDF/Excel" as UC30
}

' ---------- Relasi aktor ----------
C --> UC01
C --> UC02
C --> UC03
C --> UC05
C --> UC07
C --> UC08
C --> UC09

A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC17
A --> UC18
A --> UC19
A --> UC20
A --> UC21
A --> UC22
A --> UC23
A --> UC24
A --> UC25

P --> UC10
P --> UC11
P --> UC26
P --> UC27
P --> UC28
P --> UC29
P --> UC30

' ---------- Relasi antar use case ----------
UC03 ..> UC04 : <<include>>
UC03 ..> UC02 : <<include>>
UC05 ..> UC06 : <<include>>
UC08 ..> UC05 : <<extend>>
UC19 ..> UC20 : <<include>>
UC22 ..> UC24 : <<extend>>

note bottom of C
  Customer tidak memiliki akun, tidak login,
  dan tidak melakukan registrasi. Identitas
  transaksi adalah Service ID (format
  FP-YYYYMMDD-XXXXX).
end note

note bottom of A
  Teknisi bukan aktor aplikasi. Seluruh pekerjaan
  teknis (diagnosis, pengerjaan, pembayaran)
  dicatat oleh Admin yang sedang login.
end note

note bottom of P
  Pemilik Usaha bersifat read-only: tidak dapat
  mengubah booking, jadwal, layanan, maupun
  pembayaran. Laporan pemasukan hanya tersedia
  untuk peran ini.
end note

@enduml
