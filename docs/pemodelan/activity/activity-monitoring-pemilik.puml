@startuml activity-monitoring-pemilik
title Activity Diagram — Pemilik Usaha Memantau Operasional

|Pemilik Usaha|
start
:Login dengan role Pemilik Usaha;
:Buka dashboard pemantauan;

|Sistem|
:Validasi sesi dan role (PEMILIK_USAHA);
if (Role sesuai?) then (tidak)
  :Tampilkan 403 Akses Ditolak;
  stop
else (ya)
  :Hitung statistik servis aktif,
  booking menunggu, servis selesai,
  dan pembayaran tertunda;
  :Ambil daftar booking beserta
  diagnosis, biaya, dan status;
  :Ambil riwayat servis selesai;
  :Ambil bukti pembayaran QRIS terbaru;
  :Tampilkan dashboard read-only;
endif

|Pemilik Usaha|
if (Aktivitas?) then (Lihat bukti QRIS)
  :Klik Lihat Bukti;
  |Sistem|
  :Stream gambar bukti (private, no-store);
  :Tampilkan bukti tanpa aksi perubahan;
  stop

elseif (Riwayat servis)
  |Pemilik Usaha|
  :Pilih rentang tanggal;
  |Sistem|
  :Filter service_records COMPLETED
  berdasarkan completed_at;
  :Tampilkan tabel dan ringkasan biaya;
  |Pemilik Usaha|
  if (Unduh laporan?) then (PDF)
    :Unduh PDF riwayat servis;
  elseif (Excel)
    :Unduh XLSX riwayat servis;
  else (tidak)
  endif
  stop

elseif (Laporan pemasukan)
  |Pemilik Usaha|
  :Pilih periode dan metode pembayaran;
  |Sistem|
  :Hitung SUM(amount) untuk
  payment_status PAID;
  :Tampilkan total, CASH, QRIS,
  dan jumlah transaksi;
  |Pemilik Usaha|
  if (Unduh laporan?) then (PDF)
    :Unduh PDF laporan pemasukan;
  elseif (Excel)
    :Unduh XLSX laporan pemasukan;
  else (tidak)
  endif
  stop

else (Selesai)
  stop
endif

@enduml
