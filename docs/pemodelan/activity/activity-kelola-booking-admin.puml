@startuml activity-kelola-booking-admin
title Activity Diagram — Admin Mengelola Booking Servis

|Admin|
start
:Login sebagai Admin;
:Buka menu Kelola Proses Servis;
:Lihat daftar booking
(filter status aktif / semua);
:Pilih booking;

|Sistem|
:Tampilkan detail booking:
keluhan awal, perangkat, layanan,
jadwal, dan status;

|Admin|
if (Booking berstatus PENDING?) then (ya)
  :Klik Terima Booking;
  |Sistem|
  :Mulai transaksi dan kunci booking;
  if (Status masih PENDING / WAITING_VERIFICATION?) then (tidak)
    :Tolak verifikasi dan tampilkan alasan;
    stop
  else (ya)
    :Buat catatan servis (status PENDING)
    dengan handled_by Admin;
    :Ubah status booking menjadi CONFIRMED;
    :Commit transaksi;
    :Tampilkan pesan booking diterima;
    stop
  endif
else (tidak)
  |Admin|
  if (Booking perlu dibatalkan?) then (ya)
    :Klik Batalkan Booking;
    :Isi alasan pembatalan (maks 500 karakter);
    |Sistem|
    :Validasi alasan;
    :Mulai transaksi dan kunci booking;
    if (Status booking masih dapat dibatalkan?) then (tidak)
      :Tolak pembatalan
      (sudah dikerjakan/selesai);
      stop
    else (ya)
      :Ubah status menjadi CANCELLED
      dan simpan alasan;
      :Kurangi current_booking jadwal;
      :Commit transaksi;
      :Tampilkan pesan pembatalan berhasil;
      stop
    endif
  else (tidak)
    :Lanjutkan ke proses servis
    (lihat activity-proses-servis-admin);
    stop
  endif
endif

@enduml
