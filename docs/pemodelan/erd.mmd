%% ERD FixPoint Service
%% Sumber: database/migrations + inspeksi Schema::getColumns/getForeignKeys pada database MySQL aktif.
%% Kardinalitas mengikuti foreign key yang benar-benar terpasang.

erDiagram
    users {
        bigint user_id PK "Auto increment"
        varchar email UK "Login Admin & Pemilik Usaha"
        varchar password "Hash bcrypt"
        enum role "ADMIN, PEMILIK_USAHA"
        timestamp created_at
        timestamp updated_at
    }

    customers {
        bigint customer_id PK
        varchar name "Nama pelanggan"
        varchar phone_number "Dipakai untuk mencocokkan pelanggan saat booking (tidak unik)"
        varchar email "Nullable, belum diisi aplikasi"
        text address "Nullable, belum diisi aplikasi"
        timestamp created_at
        timestamp updated_at
    }

    services {
        bigint service_id PK
        varchar name "Contoh: Servis Laptop"
        text description "Nullable"
        decimal estimated_price "12,2 - nullable"
        tinyint is_active "Default 1"
        timestamp created_at
        timestamp updated_at
    }

    schedules {
        bigint schedule_id PK
        date schedule_date "Tanggal sesi servis"
        time start_time "Jam mulai"
        time end_time "Jam selesai"
        int max_booking "Kapasitas slot, default 1"
        int current_booking "Slot terpakai, default 0"
        enum status "AVAILABLE, FULL, CLOSED"
        timestamp created_at
        timestamp updated_at
    }

    devices {
        bigint device_id PK
        bigint customer_id FK "ON DELETE CASCADE"
        varchar device_type "Laptop / PC Desktop"
        varchar brand "Diisi string kosong untuk PC Desktop"
        varchar model "Diisi string kosong untuk PC Desktop"
        text complaint "Keluhan awal pelanggan"
        timestamp created_at
        timestamp updated_at
    }

    bookings {
        bigint booking_id PK
        varchar service_id_code UK "Format FP-YYYYMMDD-XXXXX"
        bigint customer_id FK
        bigint device_id FK
        bigint service_id FK "ON DELETE RESTRICT"
        bigint schedule_id FK "ON DELETE RESTRICT"
        bigint handled_by FK "Nullable, mengacu users.user_id"
        datetime booking_date "Diisi now() saat booking dibuat"
        enum status "PENDING, WAITING_VERIFICATION, CONFIRMED, REJECTED, COMPLETED, CANCELLED"
        text notes "Nullable"
        text cancellation_reason "Nullable, diisi saat pembatalan"
        timestamp created_at
        timestamp updated_at
    }

    service_records {
        bigint service_record_id PK
        bigint booking_id FK "Tidak unik di database"
        bigint handled_by FK "Admin yang menangani"
        text diagnosis "Nullable"
        decimal estimated_cost "12,2 - nullable"
        decimal final_cost "12,2 - nullable"
        enum service_status "PENDING, DIAGNOSIS, PROCESS, COMPLETED"
        text service_notes "Nullable, menampung estimasi durasi & catatan"
        datetime started_at "Nullable"
        datetime completed_at "Nullable"
        timestamp created_at
        timestamp updated_at
    }

    payments {
        bigint payment_id PK
        bigint customer_id FK "Denormalisasi dari booking"
        bigint booking_id FK "UNIQUE, nullable"
        bigint service_record_id FK "Nullable, diisi saat servis selesai"
        bigint processed_by FK "Nullable, admin yang memverifikasi"
        decimal amount "12,2 - 0 saat booking, final_cost saat selesai"
        decimal cash_received "Nullable, wajib untuk CASH"
        enum payment_method "QRIS, CASH"
        enum payment_status "UNPAID, WAITING_VERIFICATION, PAID"
        varchar payment_proof "Nullable, path bukti QRIS"
        datetime payment_date "Nullable"
        text notes "Nullable, catatan penolakan bukti"
        timestamp created_at
        timestamp updated_at
    }

    %% Relasi
    customers ||--o{ devices : "memiliki"
    customers ||--o{ bookings : "melakukan"
    customers ||--o{ payments : "membayar"
    services  ||--o{ bookings : "dipilih pada"
    schedules ||--o{ bookings : "menampung"
    devices   ||--o{ bookings : "dilayani pada"
    bookings  ||--o| service_records : "memiliki catatan servis"
    bookings  ||--o| payments : "memiliki pembayaran"
    service_records ||--o| payments : "menjadi dasar tagihan"
    users ||--o{ bookings : "menangani (handled_by)"
    users ||--o{ service_records : "mencatat (handled_by)"
    users ||--o{ payments : "memverifikasi (processed_by)"
