%% Flowchart — Admin
%% Berdasarkan route /login dan grup /admin/* (middleware auth + role:ADMIN)

flowchart TD
    A([Mulai]) --> B[Buka halaman login]
    B --> C[Isi email, password, pilih role Admin]
    C --> D{Kredensial valid?}
    D -->|Tidak| E[Tampilkan pesan<br/>email/password salah]
    E --> B

    D -->|Ya| F{Role akun = ADMIN?}
    F -->|Tidak| G[Logout + pesan<br/>role tidak sesuai]
    G --> B

    F -->|Ya| H[Dashboard Admin]
    H --> I{Pilih menu}

    I -->|Jadwal Servis| J[Kelola Jadwal]
    J --> J1{Aksi jadwal?}
    J1 -->|Tambah| J2[Isi tanggal, jam,<br/>jumlah slot]
    J2 --> J3{Bentrok jadwal lain?}
    J3 -->|Ya| J4[Pesan bentrok]
    J3 -->|Tidak| J5[Jadwal tersimpan<br/>status AVAILABLE]

    J1 -->|Edit| J6[Form edit terisi nilai lama]
    J6 --> J7{Kapasitas baru minimal<br/>sama dengan slot terpakai?}
    J7 -->|Tidak| J8[Tolak perubahan]
    J7 -->|Ya| J9{Tanggal/jam berubah<br/>dan sudah ada booking?}
    J9 -->|Ya| J10[Tolak perubahan waktu]
    J9 -->|Tidak| J11{Tanggal/jam<br/>bertabrakan?}
    J11 -->|Ya| J8
    J11 -->|Tidak| J12[Simpan perubahan<br/>status dihitung ulang]

    J1 -->|Tutup/Buka| J13[Ubah status CLOSED /<br/>AVAILABLE / FULL]
    J1 -->|Hapus| J14{Ada booking terkait?}
    J14 -->|Ya| J15[Tolak hapus,<br/>sarankan Tutup Jadwal]
    J14 -->|Tidak| J16[Jadwal dihapus]

    I -->|Data Service| K[Kelola layanan]
    K --> K1[Tambah / ubah layanan<br/>atau aktif-nonaktifkan]

    I -->|Proses Servis| L[Lihat booking masuk]
    L --> L1{Booking PENDING?}
    L1 -->|Ya| L2[Verifikasi booking]
    L2 --> L3[Booking CONFIRMED +<br/>catatan servis dibuat]
    L1 -->|Tidak| L4[Lihat detail servis]
    L3 --> L4

    L4 --> L5[Isi diagnosis, estimasi biaya,<br/>status servis]
    L5 --> L6{Status = COMPLETED?}
    L6 -->|Ya| L7{Biaya akhir lebih dari 0?}
    L7 -->|Tidak| L5
    L7 -->|Ya| L8[Booking COMPLETED,<br/>tagihan = biaya akhir]
    L6 -->|Tidak| L8

    I -->|Pembayaran| M[Lihat daftar tagihan]
    M --> M1{Metode?}
    M1 -->|CASH| M2[Input uang diterima]
    M2 --> M3{Uang diterima minimal<br/>sama dengan tagihan?}
    M3 -->|Tidak| M4[Tolak konfirmasi]
    M3 -->|Ya| M5[Status PAID]
    M1 -->|QRIS| M6{Bukti sudah diunggah<br/>dan menunggu verifikasi?}
    M6 -->|Tidak| M7[Tolak konfirmasi /<br/>minta upload ulang]
    M6 -->|Ya| M5
    M5 --> M8[Struk dapat dicetak]

    I -->|Riwayat dan Laporan| N[Riwayat servis<br/>filter tanggal]
    N --> N1[Unduh PDF / Excel]

    J5 --> O([Selesai])
    J12 --> O
    J13 --> O
    J16 --> O
    K1 --> O
    L8 --> O
    M8 --> O
    N1 --> O
