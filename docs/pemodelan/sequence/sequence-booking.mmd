%% Sequence Diagram — Customer melakukan booking servis
%% Sumber implementasi: BookingController@store, routes/web.php (POST /booking)

sequenceDiagram
    autonumber
    actor C as Customer
    participant W as Route /booking
    participant BC as BookingController
    participant V as Validator
    participant DB as Database MySQL
    participant S as schedules
    participant CU as customers
    participant D as devices
    participant B as bookings
    participant P as payments

    C->>W: Buka halaman booking
    W-->>C: Form + daftar jadwal AVAILABLE yang belum penuh

    C->>W: Kirim form (nama, telepon, perangkat, layanan, keluhan, jadwal, metode bayar)
    W->>BC: POST /booking (store)
    BC->>V: validate(request)
    alt Validasi gagal
        V-->>BC: ValidationException
        BC-->>C: Kembali ke form + pesan error per field
    else Valid
        BC->>DB: BEGIN TRANSACTION
        BC->>S: SELECT ... FOR UPDATE (schedule_id, schedule_date >= hari ini)

        alt Jadwal tidak ditemukan / status bukan AVAILABLE / current_booking >= max_booking
            BC-->>C: error "jadwal penuh atau tidak tersedia"
            Note over DB: Transaksi diakhiri tanpa perubahan
        else Slot tersedia
            BC->>CU: Cari berdasarkan phone_number
            alt Pelanggan belum ada
                BC->>CU: INSERT customer (name, phone_number)
            end
            BC->>D: INSERT device (customer_id, device_type, brand, model, complaint)

            loop Sampai Service ID unik
                BC->>B: Cek service_id_code = FP-YYYYMMDD-XXXXX
            end

            BC->>B: INSERT booking (status PENDING, booking_date = now())
            BC->>P: INSERT payment (amount 0, metode pilihan, status UNPAID)
            BC->>S: increment current_booking
            opt Kuota habis
                BC->>S: update status = FULL
            end
            BC->>DB: COMMIT
            BC-->>C: Redirect /booking + flash Service ID
            Note over C: Service ID disimpan pelanggan untuk cek status
        end
    end
