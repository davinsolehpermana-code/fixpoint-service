%% Sequence Diagram — Customer mengecek status servis
%% Sumber implementasi: StatusController@show, route GET /cek-status/result,
%% view status/cek-status.blade.php

sequenceDiagram
    autonumber
    actor C as Customer
    participant W as Route /cek-status
    participant SC as StatusController
    participant V as Validator
    participant DB as Database MySQL
    participant B as bookings
    participant SR as service_records

    C->>W: Buka /cek-status
    W-->>C: Form input Service ID

    C->>W: GET /cek-status/result?code=FP-...
    W->>SC: show(request)
    SC->>V: validate(code required, max 50)
    alt Tidak valid
        V-->>C: Pesan "Service ID tidak valid"
    else Valid
        SC->>B: SELECT booking + customer, device, schedule, service, payment (where service_id_code)
        alt Booking tidak ditemukan
            SC-->>C: Redirect /cek-status + "Service ID tidak ditemukan"
        else Ditemukan
            SC->>SR: SELECT service_record terbaru by booking_id
            SR-->>SC: diagnosis, biaya, status servis
            SC-->>C: Halaman status: data perangkat, jadwal, diagnosis, estimasi, biaya akhir, status servis, status pembayaran

            opt Servis COMPLETED dan pembayaran QRIS belum lunas
                C->>SC: POST /cek-status/upload-proof (lihat sequence-upload-bukti-qris)
            end

            opt Booking masih PENDING / WAITING_VERIFICATION
                C->>SC: POST /cek-status/{code}/cancel + alasan
                SC->>DB: BEGIN TRANSACTION
                SC->>B: SELECT booking FOR UPDATE
                SC->>B: status = CANCELLED, cancellation_reason
                SC->>DB: UPDATE schedules current_booking - 1
                opt Status jadwal FULL dan slot tersisa
                    SC->>DB: status schedule = AVAILABLE
                end
                SC->>DB: COMMIT
                SC-->>C: "Booking dibatalkan, slot dikembalikan"
            end
        end
    end
