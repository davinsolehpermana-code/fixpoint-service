%% Sequence Diagram — Customer mengunggah bukti pembayaran QRIS
%% Sumber implementasi: StatusController@uploadProof,
%% route POST /cek-status/upload-proof, PaymentProofController

sequenceDiagram
    autonumber
    actor C as Customer
    participant SC as StatusController
    participant V as Validator
    participant FS as Storage disk public
    participant DB as Database MySQL
    participant B as bookings
    participant P as payments

    C->>SC: POST /cek-status/upload-proof (service_id_code + file gambar)
    SC->>V: validate(file image, mimes jpeg/png/jpg/webp, mimetypes, max 2MB)
    alt File tidak valid
        V-->>C: Pesan "format/ukuran bukti tidak sesuai"
    else Valid
        SC->>FS: store('payment_proofs', 'public')
        FS-->>SC: path bukti baru
        SC->>DB: BEGIN TRANSACTION
        SC->>B: SELECT booking FOR UPDATE by service_id_code

        alt Booking belum COMPLETED
            SC-->>C: Error "bukti hanya setelah servis selesai"
        else Payment tidak ada
            SC-->>C: Error "hubungi Admin"
        else Metode bukan QRIS
            SC-->>C: Error "upload hanya untuk QRIS"
        else amount <= 0
            SC-->>C: Error "tagihan belum ditetapkan"
        else Sudah PAID
            SC-->>C: Error "pembayaran sudah lunas"
        else Sedang WAITING_VERIFICATION
            SC-->>C: Error "bukti sebelumnya sedang diverifikasi"
        else Valid
            SC->>P: UPDATE payment_proof, status WAITING_VERIFICATION, payment_date
            SC->>DB: COMMIT
            SC->>FS: Hapus file bukti lama (jika ada dan berbeda)
            SC-->>C: "Bukti terkirim, menunggu verifikasi Admin"
            Note over C: Admin memverifikasi melalui /admin/pembayaran
        end

        opt Terjadi exception saat transaksi
            SC->>FS: Hapus file baru agar tidak menjadi orphan
            SC-->>C: Halaman error 500
        end
    end

    opt Customer membuka kembali bukti yang pernah diunggah
        C->>SC: GET /cek-status/{code}/bukti-pembayaran
        SC->>SC: PaymentProofController@showForCustomer
        alt Booking COMPLETED dan payment QRIS dengan proof
            SC-->>C: Stream gambar inline (private, no-store)
        else Tidak valid
            SC-->>C: 404
        end
    end
