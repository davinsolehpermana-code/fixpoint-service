%% Sequence Diagram — Admin mengelola jadwal servis (tambah, edit, tutup, hapus)
%% Sumber implementasi: AdminPanelController (schedules, storeSchedule, editSchedule,
%% updateSchedule, updateScheduleStatus, destroySchedule), routes/web.php grup role:ADMIN

sequenceDiagram
    autonumber
    actor A as Admin
    participant MW as Middleware auth + role:ADMIN
    participant AC as AdminPanelController
    participant DB as Database MySQL
    participant V as Validator

    A->>MW: GET /admin/jadwal-servis
    MW->>MW: Cek sesi login & role ADMIN
    alt Bukan Admin
        MW-->>A: 403 Akses Ditolak
    else Admin
        MW->>AC: schedules()
        AC->>DB: SELECT schedules + COUNT(bookings) per jadwal
        DB-->>AC: Daftar jadwal + bookings_total
        AC-->>A: View daftar jadwal (tanggal, jam, kuota, status, aksi)

        rect rgb(240, 249, 255)
        Note over A,DB: Alur 1 — Tambah jadwal
        A->>AC: POST /admin/jadwal-servis
        AC->>V: validate(schedule_date >= today, time, max_booking >= 1)
        AC->>DB: Cek jadwal bentrok pada tanggal sama
        alt Bentrok
            AC-->>A: Error "bertabrakan dengan jadwal yang sudah ada"
        else Tidak bentrok
            AC->>DB: INSERT schedules (current_booking 0, status AVAILABLE)
            AC-->>A: Redirect + sukses
        end
        end

        rect rgb(240, 253, 244)
        Note over A,DB: Alur 2 — Edit waktu & kapasitas slot
        A->>AC: GET /admin/jadwal-servis/{id}/edit
        AC->>DB: SELECT schedule + hitung scheduleQuota (total & booking aktif)
        AC-->>A: Form edit terisi nilai lama + ringkasan slot

        A->>AC: PUT /admin/jadwal-servis/{id}
        AC->>V: validate(tanggal, jam, max_booking 1..100, status)
        AC->>DB: BEGIN TRANSACTION
        AC->>DB: SELECT schedule FOR UPDATE
        AC->>AC: scheduleQuota(schedule)

        alt max_booking baru < slot terpakai
            AC-->>A: Error "kuota tidak boleh kurang dari slot terpakai"
        else Tanggal/jam berubah DAN sudah ada booking
            AC-->>A: Error "tanggal & jam dikunci karena sudah ada booking"
        else Bentrok dengan jadwal lain
            AC-->>A: Error "bertabrakan dengan jadwal lain"
        else Valid
            AC->>AC: status = CLOSED atau hitung ulang AVAILABLE/FULL
            AC->>DB: UPDATE schedules (tanggal, jam, max_booking, status)
            AC->>DB: COMMIT
            AC-->>A: Redirect + sukses "kapasitas X slot, sisa Y"
        end
        end

        rect rgb(254, 249, 195)
        Note over A,DB: Alur 3 — Tutup / buka jadwal
        A->>AC: PATCH /admin/jadwal-servis/{id}/status
        AC->>DB: SELECT schedule
        alt Status sekarang CLOSED
            AC->>AC: Buka jadwal (FULL / AVAILABLE)
        else Status lain
            AC->>AC: Tutup jadwal (CLOSED)
        end
        AC->>DB: UPDATE status
        AC-->>A: Redirect + sukses
        end

        rect rgb(254, 242, 242)
        Note over A,DB: Alur 4 — Hapus jadwal
        A->>AC: DELETE /admin/jadwal-servis/{id} (modal konfirmasi)
        AC->>DB: BEGIN TRANSACTION
        AC->>DB: SELECT schedule FOR UPDATE + COUNT(bookings)
        alt Ada booking terkait
            AC-->>A: Error "gunakan Tutup Jadwal" (transaksi dibatalkan)
        else Belum ada booking
            AC->>DB: DELETE schedule
            AC->>DB: COMMIT
            AC-->>A: Redirect + sukses
        end
        end
    end
