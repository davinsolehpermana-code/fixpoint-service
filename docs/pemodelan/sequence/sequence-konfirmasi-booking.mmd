%% Sequence Diagram — Admin memverifikasi booking
%% Sumber implementasi: BookingController@verifyBooking, route PUT /admin/booking/{id}/verify

sequenceDiagram
    autonumber
    actor A as Admin
    participant MW as Middleware role:ADMIN
    participant BC as BookingController
    participant DB as Database MySQL
    participant B as bookings
    participant SR as service_records

    A->>MW: PUT /admin/booking/{id}/verify
    MW->>MW: Cek login & role ADMIN
    alt Tidak berhak
        MW-->>A: 403 Akses Ditolak
    else Admin
        MW->>BC: verifyBooking(id)
        BC->>DB: BEGIN TRANSACTION
        BC->>B: SELECT booking FOR UPDATE
        alt Booking tidak ada
            BC-->>A: 404
        else Status bukan PENDING / WAITING_VERIFICATION
            BC-->>A: Error "tidak bisa diverifikasi pada status saat ini"
        else Status valid
            BC->>SR: firstOrCreate(booking_id, handled_by = Auth::id(), status PENDING)
            SR-->>BC: Catatan servis siap
            BC->>B: UPDATE status CONFIRMED, handled_by = admin
            BC->>DB: COMMIT
            BC-->>A: Redirect + "Booking diterima, catatan servis disiapkan"
            Note over A: Booking siap masuk proses diagnosis
        end
    end
